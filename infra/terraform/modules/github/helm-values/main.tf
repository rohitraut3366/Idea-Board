resource "github_repository_file" "this" {
  repository          = "Idea-Board"
  branch              = "master"
  file                = "${var.chart_path}/values/${var.cloud}/${var.cluster_name}/values-terraform.yaml"
  content             = "# Generated by Terraform. Edit the owning core-services project.\n${yamlencode(var.values)}"
  commit_message      = "Update ${var.cluster_name} ${var.chart_path} values"
  overwrite_on_create = true
}
